{
  "expo": {
    "name": "Aquadify",
    "slug": "frontend",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aquadify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mtagency.aquadify",
      "buildNumber": "23",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Aquadify utilise cette autorisation pour afficher des publicités pertinentes dans la version gratuite.",
        "NSHealthShareUsageDescription": "Aquadify utilise vos données d’activité Apple Santé afin de personnaliser votre objectif d’hydratation et vos recommandations.",
        "NSHealthUpdateUsageDescription": "Aquadify peut enregistrer certaines informations liées à votre hydratation dans Apple Santé lorsque vous activez cette fonctionnalité.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2F6FD0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mtagency.aquadify"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2F6FD0"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8009813538542789~2818700603",
          "iosAppId": "ca-app-pub-8009813538542789~7753483038"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "c25c13e4-9fe7-49d8-8605-540fe90824e2"
      }
    }
  }
}