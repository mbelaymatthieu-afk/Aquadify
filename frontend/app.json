{
  "expo": {
    "name": "Aquadify",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aquadify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mta.aquadify",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Show relevant ads in the free version"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2F6FD0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mta.aquadify"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2F6FD0"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8009813538542789~7753483038",
          "iosAppId": "ca-app-pub-8009813538542789~7753483038"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
