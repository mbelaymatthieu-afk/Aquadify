{
  "expo": {
    "name": "Aquadify",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aquadify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mtagency.aquadify",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      },
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Show relevant ads in the free version",
        "NSLocationWhenInUseUsageDescription": "Aquadify utilise votre position pour afficher les points d'eau potable les plus proches de vous, calculer leur distance et vous permettre d'obtenir un itinéraire pour vous y rendre.",
        "NSHealthShareUsageDescription": "Adapt your water goal to your activity",
        "NSHealthUpdateUsageDescription": "HealthKit requires this for permission prompts"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2F6FD0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mtagency.aquadify"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aquadify utilise votre position pour afficher les points d'eau potable les plus proches de vous, calculer leur distance et vous permettre d'obtenir un itinéraire pour vous y rendre."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2F6FD0"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8009813538542789~2818700603",
          "iosAppId": "ca-app-pub-8009813538542789~7753483038"
        }
      ],
      "expo-tracking-transparency",
      "expo-iap",
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Adapt your water goal to your activity",
          "NSHealthUpdateUsageDescription": "HealthKit requires this for permission prompts",
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "aquadifyApiUrl": "https://drip-track-1.emergent.host/api",
      "insightsApiUrl": "https://drip-track-1.emergent.host"
    }
  }
}
